# Navigatorrr configuration
# Copy to ~/.config/navigatorr/config.yaml and fill in your values
#
# `url` is optional for known services — it defaults to http://localhost:<default port>.
# Give just the host ("url: 10.0.0.100") and the default port is appended.
# Run list_services to see what each service resolved to.

services:
  sonarr:
    url: "http://localhost:8989"
    api_key: "your-sonarr-api-key"
  radarr:
    url: "http://localhost:7878"
    api_key: "your-radarr-api-key"
  lidarr:
    url: "http://localhost:8686"
    api_key: "your-lidarr-api-key"
  readarr:
    url: "http://localhost:8787"
    api_key: "your-readarr-api-key"
  chaptarr:
    url: "http://localhost:8789"
    api_key: "your-chaptarr-api-key"
  prowlarr:
    url: "http://localhost:9696"
    api_key: "your-prowlarr-api-key"
  profilarr:
    url: "http://localhost:6868"
    api_key: "your-profilarr-api-key"
  bazarr:
    url: "http://localhost:6767"
    api_key: "your-bazarr-api-key"
  seerr:
    url: "http://localhost:5055"
    api_key: "your-seerr-api-key"

transmission:
  url: "http://localhost:9091"
  username: ""
  password: ""

sabnzbd:
  url: "http://localhost:8080"
  api_key: "your-sabnzbd-api-key"
  # SABnzbd's own url_base setting. Ships as /sabnzbd, often cleared.
  url_base: "/sabnzbd"

# Request queue. Requests posted here are held until an agent works them via the
# queue_list / queue_claim / queue_resolve tools. The MCP tools work regardless,
# so omit `listen` to keep the queue agent-only with no HTTP endpoint at all.
#
# Text posted here is later read and acted on by an agent holding write access to
# every service above, so `token` is required whenever `listen` is set —
# navigatorr refuses to start rather than serve this openly. Prefer binding
# loopback and reaching it over a tunnel or reverse proxy that terminates TLS;
# ":8099" binds every interface, and the token crosses the network in clear text.
queue:
  listen: "127.0.0.1:8099"  # bind address; empty disables the HTTP endpoint
  token: "generate-a-long-random-string"
  path: ""                  # queue file; defaults to ~/.config/navigatorr/queue.json
