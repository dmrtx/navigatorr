# Navigatorr Docker Compose Template
#
# OPERATIONAL MODES:
#
# 1. On-Demand Stdio MCP Sessions (Default, spawned per-session by an MCP host):
#    Command: docker compose run --rm -T navigatorr
#    Settings: restart: "no", stdin_open: true
#
# 2. Persistent Streamable HTTP Background Service (Recommended for Portainer):
#    Command: docker compose up -d
#    Settings: restart: "unless-stopped"
#    Service command: ["-transport=streamable-http", "-listen=127.0.0.1:8098"]
#    SECURITY NOTE: When network_mode: host is active on Linux, binding 0.0.0.0:8098 exposes
#    unauthenticated MCP tools across your network. Use 127.0.0.1:8098 for local/tunnel setups,
#    or place behind an authenticating reverse proxy.
#    Endpoint: http://127.0.0.1:8098/mcp
#
# IMPORTANT CONFIGURATION RULES:
# 1. Configuration MUST be placed in config.yaml.
#    Navigatorr does NOT read environment variables (e.g. ALLOW_DESTRUCTIVE=true will be ignored).
# 2. Path Mapping: All paths in config.yaml (media.allowed_read_roots / allowed_write_roots)
#    must use the CONTAINER target paths (e.g. /media/Movies), NOT the host paths.

services:
  navigatorr:
    image: ghcr.io/dmrtx/navigatorr:latest
    pull_policy: always
    # 'host' networking allows reaching services on localhost (8989, 7878, 8080, etc.)
    network_mode: host
    stdin_open: true
    tty: false
    environment:
      # Container timezone (useful for log timestamps)
      - TZ=UTC
    volumes:
      # 1. Read-only configuration mount
      - ./config.yaml:/root/.config/navigatorr/config.yaml:ro

      # 2. Persistent SQLite database & OpenAPI spec cache
      - navigatorr-cache:/root/.cache/navigatorr

      # 3. Media libraries (mounted read-only for inspect_media and safe queries)
      - /path/on/host/Media/Anime:/media/Anime:ro
      - /path/on/host/Media/Movies:/media/Movies:ro

      # 4. Downloads directory (mounted read-write for safe_replace / cleanup operations)
      - /path/on/host/Downloads:/media/Downloads:rw

      # 5. Dedicated read-only SSH key for remote Apple Silicon transcode worker (optional)
      # - ./secrets/navigatorr_transcode_ssh:/run/secrets/navigatorr_transcode_ssh:ro
      # - ./secrets/known_hosts:/run/secrets/navigatorr_known_hosts:ro

    # Mode 1 (On-demand stdio): restart: "no"
    # Mode 2 (Persistent HTTP in Portainer): restart: "unless-stopped"
    restart: "no"

    # Enable Mode 2 (Persistent Streamable HTTP) by setting:
    # command: ["-transport=streamable-http", "-listen=127.0.0.1:8098"]
    # (Or configure mcp.transport: streamable-http and mcp.listen: 127.0.0.1:8098 in config.yaml)

volumes:
  navigatorr-cache:
